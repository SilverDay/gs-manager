{
    "name": "silverday/gspp-manager",
    "description": "Grundschutz++ KMU Compliance Manager — LAMP-basiertes ISMS-Tool für den BSI Grundschutz++",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Klaus-E. Klingner",
            "email": "klaus@silverday.de",
            "homepage": "https://silverday.de"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GsppManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GsppManager\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
