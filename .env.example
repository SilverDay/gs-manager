# GS++ Manager Configuration
# Copy to .env and fill in your values

# Application
APP_NAME="GS++ KMU Manager"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gspp_manager
DB_USERNAME=gspp
DB_PASSWORD=CHANGE_ME

# Session
SESSION_LIFETIME=30
SESSION_NAME=gspp_session

# Field Encryption (AES-256-GCM)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
FIELD_ENCRYPTION_KEY=CHANGE_ME_TO_A_64_HEX_CHAR_STRING

# AI Integration (optional)
AI_PROVIDER=claude
# claude | gemini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email (for notifications)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="GS++ Manager"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=60

# Reverse-proxy trust (set true only behind a trusted load balancer/proxy)
TRUST_PROXY=false
APP_HOSTNAME=localhost

# Deadline notifications (days ahead to notify before POA&M deadline)
NOTIFY_DAYS_AHEAD=7
